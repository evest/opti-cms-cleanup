# One client ID/secret pair per profile, from the CMS: Settings > API Keys.
# Variable names are derived from the profile name in profiles.json:
#   profile "acme-test1" -> ACME_TEST1_CLIENT_ID / ACME_TEST1_CLIENT_SECRET
# (Override per profile with "clientIdEnv" / "clientSecretEnv" if needed.)
ACME_TEST1_CLIENT_ID=
ACME_TEST1_CLIENT_SECRET=
